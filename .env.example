# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API Keys).
# Use SOMENTE a chave publishable. Nunca coloque a service_role / secret aqui:
# tudo que começa com VITE_ vai parar no código que roda no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
